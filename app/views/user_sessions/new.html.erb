<% content_for(:title, t('.title')) %>
<div class="w-full mx-auto border-1 rounded-lg">
  <div class=" border-b rounded-lg bg-[#8bc782]">
    <h1 class="text-center"><%= t('.title') %></h1>
  </div>
  <%= form_with url: login_path, method: :post do |f| %>
    <div class="mb-3 ml-3">
      <%= f.label :email, class: "block mb-1" %>
      <%= f.email_field :email, class: "border-1 rounded-lg w-5/6" %>
    </div>
    <div class="mb-3 ml-3">
      <%= f.label :password, class: "block mb-1" %>
      <%= f.password_field :password, class: "border-1 rounded-lg w-5/6" %>
    </div>
    <div class="mb-3 text-right mr-5">
      <%= f.submit t("defaults.submit.login"), class: "bg-[#A7A7A7]/50 px-1 border-1 rounded-lg" %>
    </div>
  <% end %>
</div>
<div class="flex">
  <%= link_to t(".to_users_page"), new_user_path, class: "m-auto text-sky-400 underline decoration-sky-400" %>
</div>
