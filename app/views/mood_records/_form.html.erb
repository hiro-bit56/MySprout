  <%= form_with model: @mood_record do |f| %>
    <div class="mb-3 ml-3">
      <%= f.label :record_on, class: "block mb-1" %>
      <%= f.date_field :record_on, class: "border-1 rounded-lg w-5/6" %>
    </div>
    <div class="flex w-full">
      <div class="mx-auto">
        <h2>気分</h2>
      </div>
    </div>
    <div class="flex flex-row justify-around mb-3 ">
      <% @mood_list.each do |mood| %>
        <label>
          <%= f.radio_button :mood_level, mood %>
          <%= image_tag("mood_icon/#{mood}.svg",size: "40") %>
          <p class="text-center"> <%= t("defaults.mood_level.#{mood}") %> </p>
        </label>
      <% end %>
    </div>
    <div class="mb-3 text-right mr-5">
      <%= f.submit class: "bg-[#A7A7A7]/50 px-1 border-1 rounded-lg" %>
    </div>
  <% end %>