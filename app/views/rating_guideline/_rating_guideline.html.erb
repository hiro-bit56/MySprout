<div class="w-full border-1 rounded-lg mb-3">
  <div class="mb-3 border-b rounded-lg bg-[#8bc782]">
    <h1 class="text-center">
      <%= "評価の目安" %>
    </h1>
  </div>
  <div class="w-full" data-controller="switchdisplay">
    <div id="guideline-text" class="hidden flex flex-col w-full">
      <% @rating_guidelines.each do |data| %>
        <div class="flex w-19/20 border-1 rounded-lg mx-auto mb-3">
          <div class="flex w-[25px] px-1 border-r rounded-lg bg-[#8bc782]">
            <p class="my-auto"><%= t("defaults.mood_level.#{data.rating_level}") %></p>
          </div>
          <div class="px-1">
            <%= simple_format(data.guideline_text) %>
          </div>
        </div>
      <% end %>
      <p class="w-19/20 mx-auto">
        ※あくまで参考です。<br>
        　自身の評価基準で自由に記録してください。
      </p>
    </div>
    <div class="flex mb-1 border-t rounded-lg">
      <%= button_tag "▼", type: "button", id: "guideline", class: "w-full", data: { action: "click->switchdisplay#switch" }%>
    </div>
  </div>
</div>