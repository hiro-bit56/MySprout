<% content_for(:title, t('.title')) %>
<div class="w-full mb-5 py-3 rounded-lg bg-[#ffffff]">
  <div class="mb-5">
    <h1 class="text-center text-[20px]"><%= t('.title') %></h1>
  </div>
  <%= form_with model: @user do |f| %>
    <div class="flex flex-col">
      <div class="mb-3 mx-auto w-9/10">
        <%= f.label :name, class: "mb-1" %>
        <%= f.text_field :name, class: "px-2 border-1 rounded-lg w-full bg-[#98d98e]/20" %>
      </div>
      <div class="mb-3 mx-auto w-9/10"">
        <%= f.label :email, class: "block mb-1" %>
        <%= f.email_field :email, class: "px-2 border-1 rounded-lg w-full bg-[#98d98e]/20" %>
      </div>
      <div class="mb-3 mx-auto w-9/10"">
        <%= f.label :password, class: "block mb-1" %>
        <%= f.password_field :password, class: "px-2 border-1 rounded-lg w-full bg-[#98d98e]/20" %>
      </div>
      <div class="mb-3 mx-auto w-9/10"">
        <%= f.label :password_confirmation, class: "block mb-1" %>
        <%= f.password_field :password_confirmation, class: "px-2 border-1 rounded-lg w-full bg-[#98d98e]/20" %>
      </div>
      <div class="my-3 text-center">
        <%= f.submit class: "bg-[#98d98e]/50 px-5 py-1 rounded-lg" %>
      </div>
    </div>
  <% end %>
</div>