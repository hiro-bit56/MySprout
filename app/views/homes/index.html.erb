<div class="w-full py-2 rounded-lg bg-[#ffffff]">
  <div class="mb-3">
    <h1 class="text-center text-[20px]">
      <%= "#{@year}年#{@month}月の記録" %>
    </h1>
  </div>
  <div class="w-full mb-3">
    <%= form_with url: homes_path, method: :get do |f| %>
      <div class="flex w-[230px] justify-between mx-auto">
        <div class="rounded-lg px-2 bg-[#808080]/20">
          <%= select_year(Date.current, start_year: Date.current.year, end_year: Date.current.year-5 ) %>
        </div>
        <div class="rounded-lg px-2 bg-[#808080]/20">
          <%= select_month(Date.current) %>
        </div>
        <%= f.submit t("defaults.submit.search"), class: "bg-[#98d98e]/50 px-2 rounded-lg" %>
      </div>
    <% end %>
  </div>
  <div class="w-full">
    <% @month_records.each do |record| %>
      <%= render partial: "records", locals: { record: record } %>
    <% end %>
  </div>
</div>