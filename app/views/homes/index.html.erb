<div class="w-full border-1 rounded-lg">
  <div class="mb-3 border-b rounded-lg bg-[#8bc782]">
    <h1 class="text-center">
      <%= "当日の記録" %>
    </h1>
  </div>
  <div>
    <% if @today_mood %>
      <p class="text-center text-[30px]">GOOD</p>
    <% else %>
      <div class="flex w-full">
        <div class="mx-auto mb-3">
          <h2>気分</h2>
        </div>
      </div>
      <div class="flex flex-row justify-around mb-3">
        <% @mood_list.each do |mood| %>
          <%= form_with model: @mood_record do |f| %>
            <%= f.hidden_field :record_on, value: Date.current %>
            <%= f.hidden_field :mood_level, value: mood %>
            <label>
              <%= image_tag "mood_icon/#{mood}.svg", size: "40" %>
              <%= f.submit t("defaults.mood_level.#{mood}") %>
            </label>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<div class="w-full border-1 rounded-lg bg-[#a0d8ef]/20">
  <div class="mb-3 border-b rounded-lg bg-[#8bc782]">
    <h1 class="text-center">
      <%= "#{@year}年#{@month}月の記録" %>
    </h1>
  </div>
  <div class="w-full mb-3">
    <%= form_with url: homes_path, method: :get do |f| %>
      <div class="flex w-[200px] justify-between mx-auto">
        <div class="border-1 rounded-lg">
          <%= select_year(Date.current, start_year: Date.current.year, end_year: Date.current.year-5 ) %>
        </div>
        <div class="border-1 rounded-lg">
          <%= select_month(Date.current) %>
        </div>
        <%= f.submit t("defaults.submit.search"), class: "bg-[#A7A7A7]/50 px-1 border-1 rounded-lg" %>
      </div>
    <% end %>
  </div>
  <div class="w-full">
    <% @month_records.each do |record| %>
      <%= render partial: "records", locals: { record: record } %>
    <% end %>
  </div>
</div>