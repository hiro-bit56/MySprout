<div>
  <h1>記録用</h1>
</div>
<div class="w-full border-1 rounded-lg bg-[#a0d8ef]/20">
  <div class="mb-3 border-b rounded-lg bg-[#8bc782]">
    <h1 class="text-center">
      <%= "#{@year}年#{@month}月の記録" %>
    </h1>
  </div>
  <div class="w-full mb-3">
    <%= form_with url: homes_path, method: :get do |f| %>
      <div class="flex w-[200px] justify-between mx-auto">
        <div class="border-1 rounded-lg">
          <%= select_year(Date.current, start_year: Date.current.year, end_year: Date.current.year-5 ) %>
        </div>
        <div class="border-1 rounded-lg">
          <%= select_month(Date.current) %>
        </div>
        <%= f.submit t("defaults.submit.search"), class: "bg-[#A7A7A7]/50 px-1 border-1 rounded-lg" %>
      </div>
    <% end %>
  </div>
  <div class="w-full">
    <% @records.each do |record| %>
      <%= render partial: "records", locals: { record: record } %>
    <% end %>
  </div>
</div>