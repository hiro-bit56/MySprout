<div class="w-full mb-5 py-5 rounded-lg bg-[#ffffff]">
  <div class="mb-5">
    <h1 class="text-center text-[20px]">
      今日の気分
    </h1>
  </div>
  <div>
    <% if @today_mood %>
      <div class="flex">
        <div class="flex flex-row mx-auto">
          <%= image_tag("mood_icon/#{@today_mood.mood_level}.svg", size: "30") %>
          <p class="text-[30px]"><%= t("defaults.mood_level.#{@today_mood.mood_level}") %></p>
        </div>
      </div>
    <% else %>
      <div class="flex flex-row justify-around mb-3">
        <% @mood_list.each do |mood| %>
          <%= form_with model: @mood_record do |f| %>
            <%= f.hidden_field :record_on, value: Date.current %>
            <%= f.hidden_field :mood_level, value: mood %>
            <label>
              <%= image_tag "mood_icon/#{mood}.svg", size: "40" %>
              <%= f.submit t("defaults.mood_level.#{mood}") %>
            </label>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

