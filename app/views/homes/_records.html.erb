    <%= record.record_on.strftime("%d日") %>
  </p>
  <div>
    <div class="ml-5">
      <p>
        <%= t("defaults.mood_level.#{record.mood_level}") %>
      </p>
      <%= image_tag("mood_icon/#{record.mood_level}.svg",size: "30") %>
    </div>
    <div></div>
    <div></div>
  </div>
  <div class="flex flex-col justify-between ml-auto mr-2">
    <%= link_to t("homes.index.edit"), "#", class: "bg-[#A7A7A7]/50 px-1 border-1 rounded-lg" %>
    <%= link_to t("homes.index.delete"), "#", class: "bg-[#A7A7A7]/50 px-1 border-1 rounded-lg" %>
  </div>
</div>