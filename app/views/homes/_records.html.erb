<div class="flex w-9/10 mx-auto mb-3 p-1 rounded-lg bg-[#808080]/5">
  <p>
    <%= record.record_on.strftime("%d日") %>
  </p>
  <div>
    <div class="ml-5">
      <p>
        <%= t("defaults.mood_level.#{record.mood_level}") %>
      </p>
      <%= image_tag("mood_icon/#{record.mood_level}.svg",size: "30") %>
    </div>
    <div></div>
    <div></div>
  </div>
  <div class="flex flex-col justify-between ml-auto mr-2">
    <%= link_to t("homes.index.edit"), edit_mood_record_path(record), class: "bg-[#98d98e]/30 px-1 rounded-lg" %>
    <%= link_to t("homes.index.delete"), mood_record_path(record), data: {turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm')} , class: "bg-[#98d98e]/30 px-1 rounded-lg" %>
  </div>
</div>