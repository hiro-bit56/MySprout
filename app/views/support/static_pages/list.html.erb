<div class="w-full">
  <div class="pl-5 mb-3 bg-[#8bc782]">
    <h1 class="text-[25px]"><strong>ヘルプページ</strong></h1>
  </div>

  <div class="flex mb-3 bg-[#8bc782]/50">
    <h2 class="mx-auto text-[20px]"><strong>各種資料</strong></h2>
  </div>
  <div class="flex w-[200px] mx-auto mb-3 border rounded-lg bg-[#A7A7A7]/50">
    <%= link_to "使い方", support_howto_path, class: "w-full text-center" %>
  </div>
  <div class="flex w-[200px] mx-auto mb-3 border rounded-lg bg-[#A7A7A7]/50">
    <%= link_to "利用規約", support_terms_path, class: "w-full text-center" %>
  </div>
  <div class="flex w-[200px] mx-auto mb-3 border rounded-lg bg-[#A7A7A7]/50">
