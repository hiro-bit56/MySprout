  </div>

  <div class="flex mb-3 bg-[#8bc782]/50">
    <h2 class="mx-auto text-[20px]"><strong>その他</strong></h2>
  </div>
  <div class="flex w-[200px] mx-auto mb-3 border rounded-lg bg-[#A7A7A7]/50">
